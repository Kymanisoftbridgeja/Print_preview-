<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_softbridge_pos_browser_print" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.softbridge.pos.browser.print</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting
                    id="softbridge_pos_browser_print"
                    string="Softbridge POS Browser Print"
                    help="Print the POS receipt directly from the browser print flow."
                >
                    <field name="browser_receipt_print_enabled"/>
                    <div class="content-group mt16" invisible="not browser_receipt_print_enabled">
                        <div class="row mt16">
                            <div class="col-lg-3"/>
                            <div class="col-lg-9">
                                <div>
                                    <field name="browser_receipt_auto_print"/>
                                    <label for="browser_receipt_auto_print" string="Auto-print when receipt screen opens" class="fw-normal ms-2"/>
                                </div>
                                <div class="mt8">
                                    <field name="browser_receipt_manual_button"/>
                                    <label for="browser_receipt_manual_button" string="Show Print in Browser button" class="fw-normal ms-2"/>
                                </div>
                            </div>
                        </div>
                        <div class="text-muted mt16">
                            This prints the live Odoo receipt through the browser print dialog.
                            It is the most direct way to print the on-screen receipt without going through the Windows bridge.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
