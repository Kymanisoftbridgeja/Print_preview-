<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t
        t-name="softbridge_pos_browser_print.ReceiptScreen"
        t-inherit="point_of_sale.ReceiptScreen"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[contains(@class, 'receipt-options')]/div[contains(@class, 'd-flex gap-1')][1]" position="after">
            <div class="d-flex gap-1" t-if="pos.config.browser_receipt_print_enabled &amp;&amp; pos.config.browser_receipt_manual_button">
                <button class="button btn btn-lg btn-secondary w-100 py-3" t-on-click="onPrintInBrowserClick">
                    <i t-attf-class="fa {{browserReceiptPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1" />
                    Print in Browser
                </button>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'notice')]" position="inside">
            <div t-if="browserReceiptPrint.status === 'success'" class="text-success">
                Browser print opened successfully
            </div>
            <div t-if="browserReceiptPrint.status === 'error'" class="text-danger">
                Browser receipt print failed. Check the popup/print settings in the browser.
            </div>
        </xpath>
    </t>

</templates>
